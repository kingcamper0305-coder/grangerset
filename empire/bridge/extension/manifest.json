{
  "manifest_version": 3,
  "name": "Empire Bridge",
  "version": "1.0.0",
  "description": "Remote browser control bridge for Empire",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Empire Bridge",
    "default_popup": "popup.html"
  }
}
